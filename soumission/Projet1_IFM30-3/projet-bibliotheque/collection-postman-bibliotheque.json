        "body": {
          "mode": "raw",
          "raw": "{\n  \"titre\": \"Les Miserables\",\n  \"resume\": \"Roman classique\",\n  \"anneePublication\": 1862,\n  \"isbn\": \"9780000000001\",\n  \"quantiteTotale\": 5,\n  \"quantiteDisponible\": 5,\n  \"auteurId\": 1,\n  \"categorieId\": 1\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/livres",
          "host": [
