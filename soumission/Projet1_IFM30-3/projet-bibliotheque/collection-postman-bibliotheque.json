        "body": {
          "mode": "raw",
          "raw": "{\n  \"nomComplet\": \"Jean Etudiant\",\n  \"email\": \"jean@exemple.local\",\n  \"motDePasse\": \"motdepasse123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/authentification/inscription",
