<%- include('../partials/entete', { titre, pageActive }) %>

<section class="section-titre">
  <h1>Roles</h1>
  <a class="bouton" href="/roles/nouveau">Nouveau role</a>
</section>

<div class="tableau-responsive">
  <table class="tableau">
    <thead>
      <tr>
        <th>Nom</th>
        <th>Description</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% roles.forEach((role) => { %>
        <tr>
          <td><%= role.nom %></td>
          <td><%= role.description || '-' %></td>
          <td class="actions-cellule">
            <a class="lien-action" href="/roles/<%= role.id %>/modifier">Modifier</a>
            <form action="/roles/<%= role.id %>/supprimer" method="post">
              <button class="lien-action danger" type="submit">Supprimer</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/pied') %>
