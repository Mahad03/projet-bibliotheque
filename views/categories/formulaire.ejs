<%- include('../partials/entete', { titre, pageActive }) %>

<form class="carte-formulaire" action="<%= mode === 'creation' ? '/categories/nouvelle' : '/categories/' + donnees.id + '/modifier' %>" method="post" enctype="multipart/form-data">
  <h1><%= mode === 'creation' ? 'Nouvelle categorie' : 'Modifier une categorie' %></h1>
  <label>Nom</label>
  <input type="text" name="nom" value="<%= donnees.nom || '' %>" />
  <% if (erreurs.nom) { %><p class="erreur-champ"><%= erreurs.nom %></p><% } %>

  <label>Description</label>
  <textarea name="description" rows="4"><%= donnees.description || '' %></textarea>

  <label>Image</label>
  <input type="file" name="image" accept="image/*" />
  <% if (erreurs.image) { %><p class="erreur-champ"><%= erreurs.image %></p><% } %>
  <% if (donnees.image) { %><img class="apercu-image" src="<%= donnees.image %>" alt="Image actuelle" /><% } %>

  <div class="actions-ligne">
    <button class="bouton" type="submit">Enregistrer</button>
    <a class="bouton bouton-secondaire" href="/categories">Annuler</a>
  </div>
</form>

<%- include('../partials/pied') %>
